@using BaiTap.Models;
@model List<SACH>
<!-- Sigle Product Area End Here -->
<!-- Begin FB's Banner With List Product Area -->
<div class="fb-banner_with_list-product children-books pt-40 pb-40 pt-sm-0 pt-xs-0">
    <div class="container">
        <div class="fb-section_title-2">
            <h2>SÁCH KHOA HỌC CƠ BẢN</h2>
        </div>
        <div class="fb-product_list_nav">
            <div class="row no-gutters">
                <div class="col-xl-3 col-lg-4 col-md-5">
                    <!-- Begin FB's Banner Area -->

                    <div class="fb-banner fb-img-hover-effect">
                        <a href="#">
                            <img src="~/Content/assets/images/banner/3_5.jpg" alt="FB'S Banner">
                        </a>
                    </div>
                    <!-- FB's Banner Area End Here -->
                </div>
                <div class="col-xl-9 col-lg-8 col-md-7">
                    <!-- Begin FB's List Product Area -->
                    <div class="fb-list_product">
                        <div class="fb-list_product_active owl-carousel">
                            <div class="row no-gutters">
                                @foreach (var item in Model.Take(2))
                                {
                                    <!-- Begin Sigle Product Area -->
                                    <div class="single-product list-single_product">
                                        <!-- Begin Product Image Area -->
                                        <div class="product-img list-product_img">
                                            <a href="@Url.Action("ChiTietSachKHCB", new { @idsach = item.Masach })">
                                                <img class="primary-img" src="~/Content/assets/images/hinhanhsach/@item.Anhbia" alt="FB'S Prduct">
                                            </a>
                                            <div class="sticker"><span>New</span></div>
                                            <div class="sticker-2"><span>-8</span></div>
                                        </div>
                                        <!-- Product Image Area End Here -->
                                        <!-- Begin Product Content Area -->
                                        <div class="product-content list-product_content">
                                            <h2 class="product-name">
                                                <a href="@Url.Action("ChiTietSachKHCB", new { @idsach = item.Masach })">@item.Tensach</a>
                                            </h2>
                                            <div class="rating-box">
                                                <ul class="rating">
                                                    <li><i class="fa fa-star"></i></li>
                                                    <li><i class="fa fa-star"></i></li>
                                                    <li><i class="fa fa-star"></i></li>
                                                    <li><i class="fa fa-star"></i></li>
                                                    <li><i class="fa fa-star"></i></li>
                                                </ul>
                                            </div>
                                            <div class="price-box">
                                                <span class="new-price">@item.Giaban</span>
                                            </div>
                                            <div class="product-action list-product_action">
                                                <ul class="product-action-link">
                                                    <li class="shopping-cart_link"><a href="cart.html" title="Shopping Cart"><i class="ion-bag"></i></a></li>
                                                    <li class="quick-view-btn"><a href="#" title="Quick View" data-bs-toggle="modal" data-bs-target="#exampleModalCenter"><i class="ion-eye"></i></a></li>
                                                    <li class="single-product_link"><a href="single-product.html" title="Single Product"><i class="ion-link"></i></a></li>
                                                </ul>
                                            </div>
                                        </div>
                                        <!-- Product Content Area End Here -->

                                    </div>
                                    <!-- Sigle Product Area End Here -->
                                }
                            </div>

                            <div class="row no-gutters">
                                @{int j = 1;}
                                @foreach (var item in Model.Take(4))
                                {
                                    if (j == 1 || j == 2)
                                    {
                                        j++; continue;
                                    }
                                    <!-- Begin Sigle Product Area -->
                                    <div class="single-product list-single_product">
                                        <!-- Begin Product Image Area -->
                                        <div class="product-img list-product_img">
                                            <a href="@Url.Action("ChiTietSachKHCB", new { @idsach = item.Masach })">
                                                <img class="primary-img" src="~/Content/assets/images/hinhanhsach/@item.Anhbia" alt="FB'S Prduct">
                                                <img class="secondary-img" src="~/Content/assets/images/hinhanhsach/@item.Anhbia" alt="FB'S Prduct">
                                            </a>
                                            <div class="sticker"><span>New</span></div>
                                            <div class="sticker-2"><span>-15</span></div>
                                        </div>
                                        <!-- Product Image Area End Here -->
                                        <!-- Begin Product Content Area -->
                                        <div class="product-content list-product_content">
                                            <h2 class="product-name">
                                                <a href="@Url.Action("ChiTietSachKHCB", new { @idsach = item.Masach })">@item.Tensach</a>
                                            </h2>
                                            <div class="rating-box">
                                                <ul class="rating">
                                                    <li class="no-star"><i class="fa fa-star"></i></li>
                                                    <li class="no-star"><i class="fa fa-star"></i></li>
                                                    <li class="no-star"><i class="fa fa-star"></i></li>
                                                    <li class="no-star"><i class="fa fa-star"></i></li>
                                                    <li class="no-star"><i class="fa fa-star"></i></li>
                                                </ul>
                                            </div>
                                            <div class="price-box">
                                                <span class="new-price">@item.Giaban</span>
                                            </div>
                                            <div class="product-action list-product_action">
                                                <ul class="product-action-link">
                                                    <li class="shopping-cart_link"><a href="cart.html" title="Shopping Cart"><i class="ion-bag"></i></a></li>
                                                    <li class="quick-view-btn"><a href="#" title="Quick View" data-bs-toggle="modal" data-bs-target="#exampleModalCenter"><i class="ion-eye"></i></a></li>
                                                    <li class="single-product_link"><a href="single-product.html" title="Single Product"><i class="ion-link"></i></a></li>
                                                </ul>
                                            </div>
                                        </div>
                                        <!-- Product Content Area End Here -->
                                    </div>
                                    <!-- Sigle Product Area End Here -->

                                }

                            </div>



                            <div class="row no-gutters">
                                @{ int i = 1;}
                                @foreach (var item in Model.Take(6))
                                {
                                    if (i == 1 || i == 2 || i == 3 || i == 4)
                                    {
                                        i++; continue;
                                    }

                                    <!-- Begin Sigle Product Area -->
                                    <div class="single-product list-single_product">
                                        <!-- Begin Product Image Area -->
                                        <div class="product-img list-product_img">
                                            <a href="@Url.Action("ChiTietSachKHCB", new { @idsach = item.Masach })">
                                                <img class="primary-img" src="~/Content/assets/images/hinhanhsach/@item.Anhbia" alt="FB'S Prduct">
                                                <img class="secondary-img" src="~/Content/assets/images/hinhanhsach/@item.Anhbia" alt="FB'S Prduct">
                                            </a>
                                            <div class="sticker"><span>New</span></div>
                                        </div>
                                        <!-- Product Image Area End Here -->
                                        <!-- Begin Product Content Area -->
                                        <div class="product-content list-product_content">
                                            <h2 class="product-name">
                                                <a href="@Url.Action("ChiTietSachKHCB", new { @idsach = item.Masach })">@item.Tensach</a>
                                            </h2>
                                            <div class="rating-box">
                                                <ul class="rating">
                                                    <li class="no-star"><i class="fa fa-star"></i></li>
                                                    <li class="no-star"><i class="fa fa-star"></i></li>
                                                    <li class="no-star"><i class="fa fa-star"></i></li>
                                                    <li class="no-star"><i class="fa fa-star"></i></li>
                                                    <li class="no-star"><i class="fa fa-star"></i></li>
                                                </ul>
                                            </div>
                                            <div class="price-box">
                                                <span class="new-price">@item.Giaban</span>
                                            </div>
                                            <div class="product-action list-product_action">
                                                <ul class="product-action-link">
                                                    <li class="shopping-cart_link"><a href="cart.html" title="Shopping Cart"><i class="ion-bag"></i></a></li>
                                                    <li class="quick-view-btn"><a href="#" title="Quick View" data-bs-toggle="modal" data-bs-target="#exampleModalCenter"><i class="ion-eye"></i></a></li>
                                                    <li class="single-product_link"><a href="single-product.html" title="Single Product"><i class="ion-link"></i></a></li>
                                                </ul>
                                            </div>
                                        </div>
                                        <!-- Product Content Area End Here -->
                                    </div>
                                    <!-- Sigle Product Area End Here -->
                                }
                            </div>

                            <div class="row no-gutters">
                                @{ int h = 1; }
                                @foreach (var item in Model.Take(8))
                                {
                                    if (h == 1 || h == 2 || h == 3 || h == 4 || h == 5 || h == 6)
                                    {
                                        h++; continue;
                                    }



                                    <!-- Begin Sigle Product Area -->
                                    <div class="single-product list-single_product">
                                        <!-- Begin Product Image Area -->
                                        <div class="product-img list-product_img">
                                            <a href="@Url.Action("ChiTietSachKHCB", new { @idsach = item.Masach })">
                                                <img class="primary-img" src="~/Content/assets/images/hinhanhsach/@item.Anhbia" alt="FB'S Prduct">
                                                <img class="secondary-img" src="~/Content/assets/images/hinhanhsach/@item.Anhbia" alt="FB'S Prduct">
                                            </a>
                                            <div class="sticker"><span>New</span></div>
                                        </div>
                                        <!-- Product Image Area End Here -->
                                        <!-- Begin Product Content Area -->
                                        <div class="product-content list-product_content">
                                            <h2 class="product-name">
                                                <a href="@Url.Action("ChiTietSachKHCB", new { @idsach = item.Masach })">@item.Tensach</a>
                                            </h2>
                                            <div class="rating-box">
                                                <ul class="rating">
                                                    <li class="no-star"><i class="fa fa-star"></i></li>
                                                    <li class="no-star"><i class="fa fa-star"></i></li>
                                                    <li class="no-star"><i class="fa fa-star"></i></li>
                                                    <li class="no-star"><i class="fa fa-star"></i></li>
                                                    <li class="no-star"><i class="fa fa-star"></i></li>
                                                </ul>
                                            </div>
                                            <div class="price-box">
                                                <span class="new-price">@item.Giaban</span>
                                            </div>
                                            <div class="product-action list-product_action">
                                                <ul class="product-action-link">
                                                    <li class="shopping-cart_link"><a href="cart.html" title="Shopping Cart"><i class="ion-bag"></i></a></li>
                                                    <li class="quick-view-btn"><a href="#" title="Quick View" data-bs-toggle="modal" data-bs-target="#exampleModalCenter"><i class="ion-eye"></i></a></li>
                                                    <li class="single-product_link"><a href="single-product.html" title="Single Product"><i class="ion-link"></i></a></li>
                                                </ul>
                                            </div>
                                        </div>
                                        <!-- Product Content Area End Here -->
                                    </div>
                                    <!-- Sigle Product Area End Here -->
                                }
                            </div>
                        </div>
                    </div>
                    <!-- FB's List Product Area End Here -->
                </div>
            </div>
        </div>
    </div>
</div>
<!-- FB's Banner With List Product Area End Here -->