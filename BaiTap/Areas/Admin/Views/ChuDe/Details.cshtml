@model BaiTap.Models.CHUDE

@{
    ViewBag.Title = "Chi tiết chủ đề";
}

<div class="container py-4">

    <div class="mb-4">
        <h2 class="fw-bold">
            <i class="bi bi-info-circle text-info"></i>
            Chi tiết chủ đề
        </h2>

        <p class="text-muted">
            Thông tin của chủ đề sách
        </p>
    </div>

    <div class="card border-0 shadow-sm">

        <div class="card-body p-4">

            <div class="row mb-4">

                <div class="col-md-3 text-muted">
                    Mã chủ đề
                </div>

                <div class="col-md-9">
                    <span class="badge bg-light text-dark border px-3 py-2">
                        #@Model.MaCD
                    </span>
                </div>

            </div>

            <hr />

            <div class="row mb-4">

                <div class="col-md-3 text-muted">
                    Tên chủ đề
                </div>

                <div class="col-md-9">
                    <h5 class="fw-bold mb-0">
                        @Model.TenChuDe
                    </h5>
                </div>

            </div>

            <hr />

            <div class="row mb-4">

                <div class="col-md-3 text-muted">
                    Số lượng sách
                </div>

                <div class="col-md-9">

                    <span class="badge rounded-pill bg-primary-subtle text-primary px-3 py-2">
                        @(Model.SACHes == null ? 0 : Model.SACHes.Count) sách
                    </span>

                </div>

            </div>

            <div class="d-flex gap-2">

                <a href="@Url.Action("Edit", new { id = Model.MaCD })"
                   class="btn btn-warning px-4">

                    <i class="bi bi-pencil"></i>
                    Chỉnh sửa
                </a>

                <a href="@Url.Action("Index")"
                   class="btn btn-light border px-4">

                    <i class="bi bi-arrow-left"></i>
                    Quay lại
                </a>

            </div>

        </div>
    </div>

</div>

