@model BaiTap.Models.CHUDE

@{
    ViewBag.Title = "Xóa chủ đề";
}

<div class="container py-4">

    <div class="mb-4">

        <h2 class="fw-bold text-danger">
            <i class="bi bi-trash"></i>
            Xóa chủ đề
        </h2>

        <p class="text-muted">
            Xác nhận xóa chủ đề khỏi hệ thống
        </p>

    </div>

    <div class="card border-0 shadow-sm">

        <div class="card-body p-4">

            <div class="alert alert-danger">

                <i class="bi bi-exclamation-triangle-fill"></i>

                <strong>Cảnh báo!</strong>

                Bạn có chắc chắn muốn xóa chủ đề này không?

            </div>

            <div class="bg-light rounded p-4 mb-4">

                <div class="row mb-3">

                    <div class="col-md-3 text-muted">
                        Mã chủ đề
                    </div>

                    <div class="col-md-9">
                        <strong>#@Model.MaCD</strong>
                    </div>

                </div>

                <div class="row">

                    <div class="col-md-3 text-muted">
                        Tên chủ đề
                    </div>

                    <div class="col-md-9">
                        <strong>@Model.TenChuDe</strong>
                    </div>

                </div>

            </div>

            @using (Html.BeginForm(
                "DeleteConfirmed",
                "ChuDe",
                FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                @Html.HiddenFor(model => model.MaCD)

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-danger px-4">

                        <i class="bi bi-trash"></i>
                        Xác nhận xóa
                    </button>

                    <a href="@Url.Action("Index")"
                       class="btn btn-light border px-4">

                        <i class="bi bi-arrow-left"></i>
                        Hủy
                    </a>

                </div>
            }

        </div>
    </div>

</div>

