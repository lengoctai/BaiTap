@model BaiTap.Models.NHAXUATBAN
@{
    ViewBag.Title = "Chi tiết Nhà Xuất Bản";
    Layout = "~/Views/Layout/LayoutUser.cshtml";
}

<!-- Begin Body Wraper Area -->
<div class="body-wrapper">
    
    <!-- Begin FB's Breadcrumb Area -->
    <div class="breadcrumb-area pt-30">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <div class="breadcrumb-content">
                        <ul>
                            <li><a href="@Url.Action("Index","Home")">Trang chủ</a></li>
                            <li><a href="@Url.Action("Index")">Quản lý Nhà Xuất Bản</a></li>
                            <li class="active">Chi tiết</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- FB's Breadcrumb Area End Here -->
    <!-- Begin Page Content Area -->
    <div class="page-section pt-60 pb-60">
        <div class="container">
            <div class="row">
                <div class="col-lg-8 offset-lg-2">
                    <div class="card">
                        <div class="card-header bg-info text-white">
                            <h3 class="mb-0"><i class="fa fa-building"></i> Chi tiết Nhà Xuất Bản</h3>
                        </div>
                        <div class="card-body">
                            <dl class="row">
                                <dt class="col-sm-4">
                                    <strong>Mã Nhà Xuất Bản:</strong>
                                </dt>
                                <dd class="col-sm-8">
                                    @Model.MaNXB
                                </dd>

                                <dt class="col-sm-4">
                                    <strong>Tên Nhà Xuất Bản:</strong>
                                </dt>
                                <dd class="col-sm-8">
                                    <strong>@Model.TenNXB</strong>
                                </dd>

                                <dt class="col-sm-4">
                                    <strong>Địa chỉ:</strong>
                                </dt>
                                <dd class="col-sm-8">
                                    @(Model.Diachi ?? "Chưa cập nhật")
                                </dd>

                                <dt class="col-sm-4">
                                    <strong>Số điện thoại:</strong>
                                </dt>
                                <dd class="col-sm-8">
                                    @(Model.DienThoai ?? "Chưa cập nhật")
                                </dd>
                            </dl>

                            <hr />

                            <div class="form-group">
                                <div class="row">
                                    <div class="col-md-4">
                                        <a href="@Url.Action("Edit", new { id = Model.MaNXB })" class="btn btn-warning btn-block">
                                            <i class="fa fa-edit"></i> Chỉnh sửa
                                        </a>
                                    </div>
                                    <div class="col-md-4">
                                        <a href="@Url.Action("Delete", new { id = Model.MaNXB })" class="btn btn-danger btn-block">
                                            <i class="fa fa-trash"></i> Xóa
                                        </a>
                                    </div>
                                    <div class="col-md-4">
                                        <a href="@Url.Action("Index")" class="btn btn-secondary btn-block">
                                            <i class="fa fa-arrow-left"></i> Quay lại
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Page Content Area End Here -->
  
</div>
<!-- Body Wraper Area End Here -->

