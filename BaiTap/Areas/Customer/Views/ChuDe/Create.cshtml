@model BaiTap.Models.ChuDeViewModel
@{
    ViewBag.Title = "Thêm Chủ Đề";
    Layout = "~/Views/Layout/LayoutUser.cshtml";
}

<!-- Begin Body Wraper Area -->
<div class="body-wrapper">
    @Html.Action("Header_Area", "Home")
    <!-- Begin FB's Breadcrumb Area -->
    <div class="breadcrumb-area pt-30">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <div class="breadcrumb-content">
                        <ul>
                            <li><a href="@Url.Action("Index","Home")">Trang chủ</a></li>
                            <li><a href="@Url.Action("Index")">Quản lý Chủ Đề</a></li>
                            <li class="active">Thêm mới</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- FB's Breadcrumb Area End Here -->
    <!-- Begin Page Content Area -->
    <div class="page-section pt-60 pb-60">
        <div class="container">
            <div class="row">
                <div class="col-lg-8 offset-lg-2">
                    <div class="card">
                        <div class="card-header bg-success text-white">
                            <h3 class="mb-0"><i class="fa fa-plus-circle"></i> Thêm Chủ Đề Mới</h3>
                        </div>
                        <div class="card-body">
                            @using (Html.BeginForm("Create", "ChuDe", FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
                            {
                                @Html.AntiForgeryToken()

                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                <div class="form-group">
                                    @Html.LabelFor(m => m.TenChuDe, new { @class = "control-label" })
                                    <span class="text-danger">*</span>
                                    @Html.TextBoxFor(m => m.TenChuDe, new { @class = "form-control", placeholder = "Nhập tên chủ đề" })
                                    @Html.ValidationMessageFor(m => m.TenChuDe, "", new { @class = "text-danger" })
                                </div>

                                <div class="form-group">
                                    @Html.LabelFor(m => m.Email, new { @class = "control-label" })
                                    <span class="text-danger">*</span>
                                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", placeholder = "example@email.com" })
                                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                                    <small class="form-text text-muted">Lưu ý: Email sẽ không được lưu vào database nếu bảng CHUDE chưa có cột Email</small>
                                </div>

                                <div class="form-group">
                                    @Html.LabelFor(m => m.DienThoai, new { @class = "control-label" })
                                    <span class="text-danger">*</span>
                                    @Html.TextBoxFor(m => m.DienThoai, new { @class = "form-control", placeholder = "Nhập số điện thoại (10-11 chữ số)" })
                                    @Html.ValidationMessageFor(m => m.DienThoai, "", new { @class = "text-danger" })
                                    <small class="form-text text-muted">Lưu ý: Số điện thoại sẽ không được lưu vào database nếu bảng CHUDE chưa có cột DienThoai</small>
                                </div>

                                <div class="form-group">
                                    @Html.LabelFor(m => m.Diachi, new { @class = "control-label" })
                                    <span class="text-danger">*</span>
                                    @Html.TextAreaFor(m => m.Diachi, new { @class = "form-control", rows = "3", placeholder = "Nhập địa chỉ" })
                                    @Html.ValidationMessageFor(m => m.Diachi, "", new { @class = "text-danger" })
                                    <small class="form-text text-muted">Lưu ý: Địa chỉ sẽ không được lưu vào database nếu bảng CHUDE chưa có cột Diachi</small>
                                </div>

                                <div class="form-group">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <button type="submit" class="btn btn-success btn-block">
                                                <i class="fa fa-save"></i> Lưu
                                            </button>
                                        </div>
                                        <div class="col-md-6">
                                            <a href="@Url.Action("Index")" class="btn btn-secondary btn-block">
                                                <i class="fa fa-arrow-left"></i> Quay lại
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Page Content Area End Here -->
    @Html.Action("Footer", "Home")
</div>
<!-- Body Wraper Area End Here -->

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}

