@section Scripts {
<script>
    // Tăng / giảm số lượng
    $('#btn-tang-sl').on('click', function () {
        var input = $('#soLuongInput');
        var max = parseInt(input.attr('max')) || 99;
        var val = parseInt(input.val()) || 1;
        if (val < max) input.val(val + 1);
    });
    $('#btn-giam-sl').on('click', function () {
        var input = $('#soLuongInput');
        var val = parseInt(input.val()) || 1;
        if (val > 1) input.val(val - 1);
    });

    // Thêm vào giỏ hàng qua AJAX
    $('#btn-them-gio').on('click', function () {
        var maSach = $(this).data('masach');
        var soLuong = parseInt($('#soLuongInput').val()) || 1;

        $.ajax({
            url: '@Url.Action("ThemVaoGio","GioHang")',
            type: 'POST',
            data: {
                maSach: maSach,
                soLuong: soLuong,
                __RequestVerificationToken: $('[name=__RequestVerificationToken]').val()
            },
            success: function (res) {
                var alertDiv = $('#them-gio-alert');
                if (res.success) {
                    alertDiv.html(
                        '<div class="alert alert-success py-2 mb-0">' +
                        '<i class="bi bi-check-circle-fill me-2"></i>' + res.message + ' ' +
                        '<a href="@Url.Action("Index","GioHang")" class="alert-link">Xem giỏ hàng</a>' +
                        '</div>'
                    ).show();
                    // Cập nhật số lượng icon giỏ hàng trên header
                    $('#cart-icon-count').text(res.soLuongGioHang);
                } else {
                    alertDiv.html(
                        '<div class="alert alert-warning py-2 mb-0">' +
                        '<i class="bi bi-exclamation-triangle me-2"></i>' + res.message +
                        '</div>'
                    ).show();
                }
                setTimeout(function () { alertDiv.fadeOut(); }, 4000);
            },
            error: function () {
                $('#them-gio-alert').html(
                    '<div class="alert alert-danger py-2 mb-0">Lỗi kết nối. Vui lòng thử lại.</div>'
                ).show();
            }
        });
    });
</script>
@Html.AntiForgeryToken()
}
